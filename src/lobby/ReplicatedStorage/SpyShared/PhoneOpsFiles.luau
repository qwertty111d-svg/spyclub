local function pick(a,l)return a[l=='en'and 2 or l=='zh'and 3 or 1]end
function F.text(l,k)return words[k]and pick(words[k],l)or k end
function F.valid(id)return type(id)=='string'and stories[id]~=nil end
function F.story(id,l)
 local source=stories[id];if not source then return nil end
 local d={id=id,choices=table.clone(source.choices)}
 for k,v in pairs(source)do if k~='choices'then d[k]=pick(v,l)end end
 return d
end
return F

function Templates.has(id)return data[id]~=nil end
function Templates.create(id)
 local record=data[id];if not record then return nil end
 local object=Instance.new("Accessory");object.Name=record.name
 object:SetAttribute("CatalogAssetId",id);object:SetAttribute("LocalWardrobeTemplate",true)
 for _,r in ipairs(record.parts)do
  local handle=Instance.new("Part");handle.Name=r.name;handle.Size=Vector3.new(table.unpack(r.size))
  handle.CFrame=CFrame.new(table.unpack(r.cf));handle.Color=Color3.new(table.unpack(r.color))
  handle.Material=Enum.Material.SmoothPlastic;handle.Anchored=true;handle.Massless=true
  handle.CanCollide=false;handle.CanTouch=false;handle.CanQuery=false
  handle.TopSurface=Enum.SurfaceType.Smooth;handle.BottomSurface=Enum.SurfaceType.Smooth
  local mesh=Instance.new("SpecialMesh");mesh.Name="Mesh";mesh.MeshType=Enum.MeshType.FileMesh
  mesh.MeshId=r.mesh.id;mesh.TextureId=r.mesh.texture
  mesh.Scale=Vector3.new(table.unpack(r.mesh.scale));mesh.Offset=Vector3.new(table.unpack(r.mesh.offset))
  mesh.VertexColor=Vector3.new(table.unpack(r.mesh.vertex));mesh.Parent=handle
  for _,a in ipairs(r.attachments)do
   local attachment=Instance.new("Attachment");attachment.Name=a.name
   attachment.CFrame=CFrame.new(table.unpack(a.cf));attachment.Parent=handle
  end
  handle.Parent=object
 end
 return object
end
return Templates

-- Bootstrap strings are embedded; no ReplicatedFirst dependency in Match.
function I18n.t(language, key, args)
    local values = strings[key]
    local text = values and values[language == "en" and 2 or 1] or key
    return (text:gsub("{([%w_]+)}", function(name) return args and tostring(args[name] or "") or "" end))
end
function I18n.word(language, word)
    if type(word) == "table" then return word[language] or word.ru end
    return word or ""
end

-- Static display copy only. User chat, names, typed input and moderation text opt out.
local aliases,patterns={},{}
local function register(pair)
 for _,value in ipairs(pair)do if value~="" and not aliases[value]then aliases[value]=pair end end
end
for _,pair in ipairs(phraseRows)do register(pair)end
for _,pair in pairs(strings)do
 local row=aliases[pair[1]]or aliases[pair[2]]
 pair[3]=pair[3]or(row and row[3]or pair[2])
 register(pair)
end
local index={ru=1,en=2,zh=3}
function I18n.normalize(locale)
 locale=type(locale)=="string"and string.lower(locale)or"ru"
 if locale=="en"or locale:sub(1,3)=="en-"then return"en"end
 if locale=="zh"or locale:sub(1,3)=="zh-"then return"zh"end
 return"ru"
end
local function escape(value)return(value:gsub("([%(%)%.%%%+%-%*%?%[%]%^%$])","%%%1"))end
-- Match complete format templates, retaining player names and numeric arguments verbatim.
for _,row in ipairs(phraseRows)do
 for sourceIndex,source in ipairs(row)do
  if source:find("%%[0-9%.]*[ds]")or source:find("{[%w_]+}")then
   local pattern,slots,last={}, {},1
   while last<=#source do
    local a,b=source:find("%%[0-9%.]*[ds]",last)
    local c,d=source:find("{[%w_]+}",last)
    if c and(not a or c<a)then a,b=c,d end
    if not a then table.insert(pattern,escape(source:sub(last)));break end
    table.insert(pattern,escape(source:sub(last,a-1)))
    local token=source:sub(a,b);table.insert(slots,token)
    table.insert(pattern,token:sub(-1)=="d"and"(%d+)"or"(.-)");last=b+1
   end
   local prefix=source:match("^([^%%{]*)")or""
   table.insert(patterns,{pattern="^"..table.concat(pattern).."$",row=row,slots=slots,prefix=prefix})
  end
 end
end
local function formatRow(template,slots,values)
 local cursor=0
 return(template:gsub("%%[0-9%.]*[ds]",function(token)
  cursor+=1;local value=values[cursor]or""
  return token:sub(-1)=="d"and string.format(token,tonumber(value)or 0)or value
 end):gsub("{([%w_]+)}",function(name)
  for i,slot in ipairs(slots)do if slot=="{"..name.."}"then return values[i]or""end end
  return""
 end))
end
-- Longest-literal trie for concatenated system captions. No substring scan over the dictionary.
local trie={}
for _,row in ipairs(phraseRows)do
 for _,source in ipairs(row)do
  if #source>=4 and not source:find("%%[0-9%.]*[ds]")and not source:find("{[%w_]+}")then
   local node=trie
   for i=1,#source do local byte=source:byte(i);node[byte]=node[byte]or{};node=node[byte]end
   if not node.row then node.row=row end
  end
 end
end
function I18n.text(locale,value,parts)
 if type(value)~="string"then return value end
 local language=I18n.normalize(locale);local target=index[language]
 local row=aliases[value];if row then return row[target]end
 if #value>2000 or value:match("^[%d%s%p]+$")then return value end
 for _,entry in ipairs(patterns)do
  if value:sub(1,#entry.prefix)==entry.prefix then
   local captures={value:match(entry.pattern)}
   if #captures>0 then return formatRow(entry.row[target],entry.slots,captures)end
  end
 end
 if not parts then return value end
 local result={};local pos=1
 while pos<=#value do
  local username=value:byte(pos)==64 and value:sub(pos):match("^@[%w_]+")
  if username then table.insert(result,username);pos+=#username;continue end
  local node=trie;local cursor=pos;local matched,finish
  while cursor<=#value and node[value:byte(cursor)]do
   node=node[value:byte(cursor)];cursor+=1
   if node.row then matched=node.row;finish=cursor end
  end
  local previous=pos>1 and value:byte(pos-1)or nil
  local following=finish and value:byte(finish)
  local function wordByte(b)return b and(b>=128 or b>=48 and b<=57 or b>=65 and b<=90 or b>=97 and b<=122 or b==95)end
  if matched and not wordByte(previous)and not(wordByte(value:byte(finish-1))and wordByte(following))then
   table.insert(result,matched[target]);pos=finish
  else table.insert(result,value:sub(pos,pos));pos+=1 end
 end
 return table.concat(result)
end
function I18n.t(language,key,args)
 local values=strings[key]
 local text=values and values[index[I18n.normalize(language)]]or key
 return(text:gsub("{([%w_]+)}",function(name)
  local value=args and args[name]or""
  if name=="item"or name=="word"then return I18n.word(language,value)end
  return tostring(value)
 end))
end
function I18n.word(language,word)
 if type(word)=="table"then word=word[I18n.normalize(language)]or word.ru or word.en or""end
 return I18n.text(language,word or"")
end
I18n.Phrases=phraseRows
local protectedNames={PlayerName=true,DisplayName=true,Username=true,PartnerDisplayName=true,
 IdentityName=true,IdentityUser=true,FeedbackText=true,AnnouncementText=true,ChatLog=true,NameTag=true,PlayerDisplay=true,TableName=true,RoomName=true,
 Messages=true,MessageLog=true,Log=true,ParticipantName=true,ParticipantUsername=true,FilteredMessage=true,SuspectName=true,WhitePlayer=true,BlackPlayer=true,InvitationIdentity=true}
function I18n.shouldTranslate(node,property)
 if node:IsA("TextBox")and property~="PlaceholderText"then return false end
 local parent=node
 while parent do
  if parent:GetAttribute("SpyUserText")==true or parent:GetAttribute("SpyLocalize")==false or(protectedNames[parent.Name]and parent:GetAttribute("SpyLocalize")~=true)then return false end
  parent=parent.Parent
 end
 return true
end
function I18n.bind(root,player)
 local records,connections={},{}
 local destroyed=false
 local function render(node,property,record)
  if destroyed or not node.Parent or not I18n.shouldTranslate(node,property)then return end
  local value=I18n.text(player:GetAttribute("SpyLanguage"),record.raw,true)
  if node[property]~=value then record.writing=true;node[property]=value;record.writing=false end
  record.applied=value
 end
 local function watch(node)
  if destroyed or records[node]then return end
  local props
  if node:IsA("TextLabel")or node:IsA("TextButton")then props={"Text"}
  elseif node:IsA("TextBox")then props={"PlaceholderText"}
  elseif node:IsA("ProximityPrompt")then props={"ActionText","ObjectText"}else return end
  records[node]={}
  for _,property in ipairs(props)do
   local record={raw=node[property]};records[node][property]=record
   record.connection=node:GetPropertyChangedSignal(property):Connect(function()
    if record.writing or node[property]==record.applied then return end
    record.raw=node[property];render(node,property,record)
   end)
   render(node,property,record)
  end
  records[node].destroy=node.Destroying:Connect(function()
   local entries=records[node];if not entries then return end
   for _,property in ipairs(props)do entries[property].connection:Disconnect()end
   entries.destroy:Disconnect();records[node]=nil
  end)
 end
 local function refresh()
  for node,entries in pairs(records)do for property,record in pairs(entries)do
   if property~="destroy"then render(node,property,record)end
  end end
 end
 table.insert(connections,player:GetAttributeChangedSignal("SpyLanguage"):Connect(refresh))
 table.insert(connections,root.DescendantAdded:Connect(function(node)task.defer(function()watch(node)end)end))
 for _,node in ipairs(root:GetDescendants())do watch(node)end
 local function destroy()
  if destroyed then return end;destroyed=true
  for _,connection in ipairs(connections)do connection:Disconnect()end
  for node,entries in pairs(records)do for property,record in pairs(entries)do
   if property=="destroy"then record:Disconnect()else record.connection:Disconnect()end
  end;records[node]=nil end
 end
 table.insert(connections,root.Destroying:Connect(destroy))
 return{refresh=refresh,destroy=destroy}
end

return I18n

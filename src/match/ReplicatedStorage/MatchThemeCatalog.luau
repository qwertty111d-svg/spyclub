-- API
---------------------------------------------------------------------

function ThemeCatalog.GetAll()
	return ThemeCatalog.Themes
end

function ThemeCatalog.GetById(id)
	for _, theme in ipairs(ThemeCatalog.Themes) do
		if theme.id == id then
			return theme
		end
	end

	return nil
end

function ThemeCatalog.GetRandomThemes(amount)
	amount = math.clamp(
		tonumber(amount) or 4,
		1,
		#ThemeCatalog.Themes
	)

	local pool = table.clone(
		ThemeCatalog.Themes
	)

	for i = #pool, 2, -1 do
		local j = math.random(1, i)

		pool[i], pool[j] =
			pool[j], pool[i]
	end

	local result = {}

	for i = 1, amount do
		result[i] = pool[i]
	end

	return result
end

function ThemeCatalog.GetRandomWord(themeId)
	local theme =
		ThemeCatalog.GetById(
			themeId
		)

	if not theme then
		return nil
	end

	if not theme.words
		or #theme.words == 0
	then
		return nil
	end

	return theme.words[
	math.random(
		1,
		#theme.words
	)
	]
end

return ThemeCatalog